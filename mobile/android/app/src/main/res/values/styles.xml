<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme (dark, black). -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/nvisco_black</item>
        <item name="android:statusBarColor">@color/nvisco_black</item>
        <item name="android:navigationBarColor">@color/nvisco_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Theme the activity switches to once the splash is gone (Capacitor looks up this exact name). -->
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Launch theme: system splash (all Android versions via androidx core-splashscreen). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nvisco_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/nvisco_black</item>
        <item name="android:navigationBarColor">@color/nvisco_black</item>
    </style>
</resources>
