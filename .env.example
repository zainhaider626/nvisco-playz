# --- required in production ---
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string      # openssl rand -hex 32
DATABASE_URL=postgres://tapempire:change-me@db:5432/tapempire
# The OWNER login for /admin.html (also the Admin button on the sign-up screen). Only you know these. Use a long password (12+ characters).
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-me-to-a-long-password
COOKIE_SECURE=true                                  # set false only if you serve plain http
TRUST_PROXY=true                                    # true when behind nginx / Caddy / Cloudflare

# --- branding ---
APP_NAME=Nvisco Playz
PORT=3000

# --- game loop ---
OFFLINE_CAP_HOURS=12                                # how long businesses keep earning while the app is closed

TICK_SECONDS=60
SEED_DEMO_BOTS=0                                    # e.g. 40 to fill leaderboards at launch (flagged DEMO, never paid)

# --- cash rewards: every value is a hard budget control ---
REWARDS_ENABLED=true
REWARD_TZ=Asia/Karachi
AD_REVENUE_SHARE=0.5                                # share of ad revenue you put into the players' pool
MAX_RATE_MICRO_PER_TAP=100                          # absolute ceiling per tap, 100 = $0.0001
DAILY_UNIT_CAP=2000                                 # reward-eligible taps per player per day
MIN_WITHDRAW_MICRO=5000000                          # $5
MIN_ACCOUNT_AGE_DAYS=3

# --- abuse limits ---
REGISTER_LIMIT_PER_HOUR=10
LOGIN_LIMIT_PER_15MIN=30

# --- top-spot auction and wallet ---
AUCTION_HOURS=24
AUCTION_SLOTS=3
AUCTION_MIN_BID_MICRO=1000000                      # $1 start
PKR_PER_USD=280                                     # default; change in the admin panel
APK_URL=                                          # public link of the latest APK; then yoursite.com/download sends people to it
